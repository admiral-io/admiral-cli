<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admiral &mdash; CLI Authentication</title>
    <style>
        :root {
            color-scheme: light;
            --canvas: #f8fafc;
            --card: #ffffff;
            --border: #e3e8ef;
            --recess: #f8fafc;
            --title: #121926;
            --body: #697586;
            --detail: #364152;
            --success: #388e3c;
            --error: #d32f2f;
            --card-shadow:
                0 1px 2px 0 rgba(15, 23, 42, 0.04),
                0 12px 32px -12px rgba(8, 13, 25, 0.12);
        }

        @media (prefers-color-scheme: dark) {
            :root {
                color-scheme: dark;
                --canvas: #0b0f19;
                --card: #111827;
                --border: #364152;
                --recess: #1e2536;
                --title: #f1f5f9;
                --body: #94a3b8;
                --detail: #e2e8f0;
                --success: #4caf50;
                --error: #f44336;
                --card-shadow: 0 24px 56px -28px rgba(0, 0, 0, 0.8);
            }
        }

        *, *::before, *::after { box-sizing: border-box; }

        html {
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            margin: 0;
            min-height: 100vh;
            min-height: 100dvh;
            padding: 3rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
                "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 1rem;
            line-height: 1.5;
            color: var(--body);
            background: var(--canvas);
        }

        .card {
            width: 100%;
            max-width: 30rem;
            padding: 3rem 2rem;
            text-align: center;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 8px;
            box-shadow: var(--card-shadow);
        }

        .brand {
            display: block;
            height: 1.875rem;
            width: auto;
            margin: 0 auto 2rem;
            color: var(--title);
        }

        .badge {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 5rem;
            height: 5rem;
            margin: 0 auto 1.5rem;
            border: 3px solid var(--status);
            border-radius: 50%;
            color: var(--status);
        }
        .badge--success { --status: var(--success); }
        .badge--error { --status: var(--error); }

        .badge svg {
            width: 2.25rem;
            height: 2.25rem;
            fill: currentColor;
        }

        h1 {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            color: var(--title);
        }

        .hint {
            margin: 0.75rem 0 0;
            font-size: 0.875rem;
            line-height: 1.625;
        }

        .detail {
            margin: 1.25rem 0 0;
            padding: 0.75rem 0.875rem;
            text-align: left;
            font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas,
                "Liberation Mono", monospace;
            font-size: 0.8125rem;
            line-height: 1.7;
            color: var(--detail);
            background: var(--recess);
            border: 1px solid var(--border);
            border-radius: 6px;
            overflow-wrap: anywhere;
        }

        .detail + .hint { margin-top: 1.25rem; }
    </style>
</head>
<body>
<main class="card">
    <svg class="brand" viewBox="0 0 90 25" fill="currentColor" role="img" aria-label="Admiral"
         xmlns="http://www.w3.org/2000/svg">
        <path d="m12.04 8.9933h3.68v13.333h-3.6933l-0.17333-1.3867q-0.52 0.77333-1.3333 1.2533-0.81333 0.48-1.9067 0.48-1.4933 0-2.7867-0.56-1.2933-0.56-2.28-1.5467t-1.5467-2.28q-0.54667-1.3067-0.54667-2.8 0-1.4267 0.52-2.6667 0.52-1.24 1.4667-2.1867 0.94667-0.94667 2.1733-1.48 1.24-0.53333 2.6667-0.53333 1.2267 0 2.2 0.52 0.98667 0.52 1.72 1.32zm-3.52 10.147q0.90667 0 1.64-0.46667 0.73334-0.46667 1.16-1.2533 0.42667-0.8 0.42667-1.76 0-0.97333-0.42667-1.76t-1.16-1.2533q-0.73333-0.46667-1.64-0.46667-0.92 0-1.6667 0.46667-0.74667 0.46667-1.1867 1.2667-0.44 0.78667-0.44 1.7467t0.44 1.76q0.45333 0.78667 1.2 1.2533 0.74667 0.46667 1.6533 0.46667zm18.4-16.813h3.68v20h-3.68v-1.4133q-0.61333 0.77333-1.52 1.2667t-2.0667 0.49333q-1.4533 0-2.72-0.54667t-2.24-1.5067q-0.96-0.97333-1.5067-2.24-0.54667-1.2667-0.54667-2.72t0.54667-2.72q0.54667-1.2667 1.5067-2.2267 0.97334-0.97333 2.24-1.52t2.72-0.54667q1.16 0 2.0667 0.49333 0.90667 0.48 1.52 1.2667zm-3.5333 16.813q0.90667 0 1.64-0.46667 0.73333-0.46667 1.16-1.2533 0.42667-0.8 0.42667-1.76 0-0.97333-0.42667-1.76-0.42667-0.78667-1.16-1.2533t-1.64-0.46667q-0.92 0-1.6667 0.46667-0.74667 0.46667-1.1867 1.2667-0.44 0.78667-0.44 1.7467t0.44 1.76q0.45333 0.78667 1.2 1.2533 0.74667 0.46667 1.6533 0.46667zm9.4133 3.1867v-13.333h3.68v0.98667q0.68-0.64 1.5733-1 0.89334-0.36 1.8933-0.36 1.36 0 2.4933 0.62667 1.1467 0.62667 1.84 1.6667 0.70667-1.04 1.84-1.6667t2.48-0.62667q1.4533 0 2.6267 0.70667 1.1867 0.70667 1.8933 1.8933 0.70667 1.1733 0.70667 2.6267v8.48h-3.68v-7.4667q0-0.69333-0.34667-1.2533-0.33333-0.57333-0.89334-0.90667-0.56-0.34667-1.2533-0.34667t-1.2667 0.33333q-0.56 0.33333-0.90667 0.90667-0.33333 0.56-0.33333 1.2667v7.4667h-3.68v-7.4667q0-0.70667-0.33333-1.2667-0.33333-0.57333-0.90667-0.90667-0.56-0.33333-1.2533-0.33333-0.68 0-1.2533 0.34667-0.56 0.33333-0.90667 0.90667-0.33333 0.56-0.33333 1.2533v7.4667zm22.693-13.333h3.68v13.333h-3.68zm1.8667-1.5333q-0.8 0-1.3467-0.53333-0.54667-0.53333-0.54667-1.32t0.54667-1.32q0.54667-0.53333 1.3333-0.53333 0.78667 0 1.32 0.53333 0.54667 0.53333 0.54667 1.32t-0.53333 1.32q-0.52 0.53333-1.32 0.53333zm3.9073 14.867-0.013333-13.333h3.68l0.01333 0.98667q0.66667-0.64 1.56-1 0.90667-0.36 1.9067-0.36 0.73333 0 1.4667 0.21333l-1.4533 3.72q-0.48-0.2-0.97333-0.2-0.69334 0-1.2667 0.33333t-0.90667 0.90667q-0.33333 0.56-0.33333 1.2667v7.4667zm18.226-13.333h3.68v13.333h-3.6933l-0.17333-1.3867q-0.52 0.77333-1.3333 1.2533-0.81333 0.48-1.9067 0.48-1.4933 0-2.7867-0.56-1.2933-0.56-2.28-1.5467t-1.5467-2.28q-0.54667-1.3067-0.54667-2.8 0-1.4267 0.52-2.6667 0.52-1.24 1.4667-2.1867 0.94667-0.94667 2.1733-1.48 1.24-0.53333 2.6667-0.53333 1.2267 0 2.2 0.52 0.98667 0.52 1.72 1.32zm-3.52 10.147q0.90667 0 1.64-0.46667 0.73333-0.46667 1.16-1.2533 0.42667-0.8 0.42667-1.76 0-0.97333-0.42667-1.76t-1.16-1.2533q-0.73334-0.46667-1.64-0.46667-0.92 0-1.6667 0.46667-0.74667 0.46667-1.1867 1.2667-0.44 0.78667-0.44 1.7467t0.44 1.76q0.45333 0.78667 1.2 1.2533 0.74667 0.46667 1.6533 0.46667zm8.8927 3.1867v-20h3.68v20z"/>
    </svg>

    <span class="badge badge--{{.Variant}}">
        {{if .Succeeded}}
            <svg viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d="M20.285 2l-11.285 11.567-5.286-5.011-3.714 3.716 9 8.728 15-15.285z"/>
            </svg>
        {{else}}
            <svg viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d="M23.954 21.03l-9.184-9.095 9.092-9.174L21.03-.046l-9.09 9.179L2.764.045l-2.81 2.81L9.14 11.96.045 21.144l2.81 2.81 9.112-9.192 9.18 9.1z"/>
            </svg>
        {{end}}
    </span>

    <h1>{{.Title}}</h1>
    {{with .Detail}}<p class="detail">{{.}}</p>{{end}}
    <p class="hint">{{.Hint}}</p>
</main>
</body>
</html>
